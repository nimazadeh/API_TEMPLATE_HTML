  {
    "apiId": "api_emails",
    "method": "POST",
    "path": "/v1/emails",
    "summary": "Send an email",
    "group": "Emails",
    "description": "Queues a transactional email for delivery to one or more recipients. Delivery status is available via the returned email id.",
    "params": [
      {
        "name": "to",
        "type": "string",
        "location": "body",
        "required": true,
        "description": "Recipient email address."
      },
      {
        "name": "subject",
        "type": "string",
        "location": "body",
        "required": true,
        "description": "Subject line for the email."
      },
      {
        "name": "html",
        "type": "string",
        "location": "body",
        "required": false,
        "description": "HTML body. Either html or text is required."
      },
      {
        "name": "from",
        "type": "string",
        "location": "body",
        "required": false,
        "description": "Sender address. Defaults to your verified domain."
      }
    ],
    "responseExample": {
      "id": "eml_8Fk2mQx1Zw",
      "status": "queued",
      "to": "user@example.com"
    },
    "id": "ep_yVMglF"
  },
